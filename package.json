{
  "name": "haiku-nextgen",
  "version": "1.0.0",
  "description": "Haiku NextGen Animator MVP",
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:react": "webpack",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:react && npm run build:electron",
    "start": "npm run build && electron .",
    "dev:react": "webpack --watch",
    "dev:electron": "tsc -p electron/tsconfig.json --watch",
    "dev": "npm run build:react && concurrently \"npm run dev:react\" \"npm run dev:electron\" \"electron .\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "konva": "^9.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "electron": "^30.0.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.6",
    "html-webpack-plugin": "^5.6.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
